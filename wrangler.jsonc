{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracuunhanh-worker",
  "main": "worker.js",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "SAPO_ORIGIN": "https://market-place.sapoapps.vn",
    "SAPO_MARKET_ACCOUNT_ID": "MTA4MDkzNQ==",
    "SAPO_CHANNEL_TYPE": "",
    "SAPO_CONNECTION_IDS": "111925,132739,142785,142786,143994,149343,149356,149584,149742",
    "SAPO_SORT_BY": "ISSUED_AT",
    "SAPO_ORDER_BY": "desc",
    "SAPO_CHANNEL_ORDER_STATUS": "PROCESSED,READY_TO_SHIP,RETRY_SHIP",
    "MAX_PAGES": "10",
    "CACHE_SECONDS": "10"
  },
  "secrets": {
    "required": [
      "SAPO_AUTHORIZATION",
      "SAPO_MARKET_TOKEN"
    ]
  }
}
